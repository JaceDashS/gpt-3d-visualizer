{
  "name": "gpt-visualizer",
  "version": "1.0.2",
  "description": "3D visualization tool for GPT token embeddings",
  "private": true,
  "scripts": {
    "client:start": "cd client && npm start",
    "client:build": "cd client && npm run build",
    "build": "cd client && npm run build",
    "client:test": "cd client && npm test",
    "dev:client": "npm run client:start",
    "spell-check": "codespell --skip='node_modules/*,package-lock.json'"
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
